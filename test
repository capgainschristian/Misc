OIDC_PROVIDER=$(aws eks describe-cluster --name <your-cluster-name> --query "cluster.identity.oidc.issuer" --output text | sed -e "s/^https:\/\///")

ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)

ROLE_NAME="<your-role-name>"
NAMESPACE="flux-system"
SA_NAME="kustomize-controller"

aws iam update-assume-role-policy \
  --role-name $ROLE_NAME \
  --policy-document '{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "Federated": "arn:aws:iam::'"$ACCOUNT_ID"':oidc-provider/'"$OIDC_PROVIDER"'"
        },
        "Action": "sts:AssumeRoleWithWebIdentity",
        "Condition": {
          "StringEquals": {
            "'"$OIDC_PROVIDER"':aud": "sts.amazonaws.com",
            "'"$OIDC_PROVIDER"':sub": "system:serviceaccount:'"$NAMESPACE"':'"$SA_NAME"'"
          }
        }
      }
    ]
  }'
